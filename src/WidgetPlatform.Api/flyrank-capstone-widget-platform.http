@flyrank_capstone_widget_platform_HostAddress = http://localhost:5296

GET {{flyrank_capstone_widget_platform_HostAddress}}/weatherforecast/
Accept: application/json

###
### Register - valid
POST https://localhost:7111/api/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "StrongPass1!"
}

### Register - weak password (should be 400)
POST https://localhost:7111/api/auth/register
Content-Type: application/json

{
  "email": "test2@example.com",
  "password": "weak"
}

### Register - duplicate email (should be 400)
POST https://localhost:7111/api/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "AnotherPass1!"
}

### Login - valid
POST https://localhost:7111/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "StrongPass1!"
}

### Login - wrong password (should be 401, same message as nonexistent email)
POST https://localhost:7111/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "WrongPassword1!"
}